# AirSense MX — Variables de entorno de desarrollo local

# AWS Configuration (development / local)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<your-dev-key>
AWS_SECRET_ACCESS_KEY=<your-dev-secret>
AWS_S3_BUCKET_BRONZE=airsense-bronze-dev
AWS_S3_BUCKET_SILVER=airsense-silver-dev
AWS_GLUE_DATABASE=airsense_dev

# Database (PostgreSQL RDS local or mock)
RDS_HOST=localhost
RDS_PORT=5432
RDS_USER=airsense
RDS_PASSWORD=dev_password_123
RDS_DBNAME=airsense_dev

# Streamlit Configuration
STREAMLIT_SERVER_HEADLESS=false
STREAMLIT_SERVER_PORT=8501

# Logging
LOG_LEVEL=INFO

# Data Sources API
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1
RAMA_SIMAT_API_URL=http://simat.inecc.gob.mx/api

# Feature Engineering
TRAIN_QUANTILE_CUTOFF=0.8
PM25_THRESHOLD_PHASE1=150.0
PM10_THRESHOLD_PHASE1=214.0
O3_THRESHOLD_PHASE1=155.0

# Feature Lags and Rolls
FEATURE_LAGS=1,3,6,24
FEATURE_ROLLS=8,24
